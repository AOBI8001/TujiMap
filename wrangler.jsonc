{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tujimap",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-08-25",
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "AMAP_GATEWAY", "class_name": "AmapGateway" }],
  },
  "migrations": [
    { "tag": "amap-gateway-v1", "new_sqlite_classes": ["AmapGateway"] },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_AMapService/*"],
  },
  "observability": {
    "enabled": true,
  },
}
